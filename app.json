{
	"expo": {
		"name": "ChatRoute",
		"slug": "chatroute",
		"version": "1.0.20",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "chatroute",
		"userInterfaceStyle": "light",
		"updates": {
			"enabled": false
		},
		"ios": {
			"icon": "./assets/images/icon.png",
			"bundleIdentifier": "com.thechatroute.app",
			"supportsTablet": false,
			"usesAppleSignIn": true,
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#FFFFFF",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"blockedPermissions": [
				"android.permission.READ_MEDIA_AUDIO",
				"android.permission.READ_MEDIA_IMAGES",
				"android.permission.READ_MEDIA_VIDEO",
				"android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
			],
			"softwareKeyboardLayoutMode": "resize",
			"package": "com.thechatroute.app"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-status-bar",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#FFFFFF",
					"image": "./assets/images/splash-icon.png"
				}
			],
			"expo-font",
			"expo-asset",
			[
				"expo-navigation-bar",
				{
					"enforceContrast": false,
					"style": "dark"
				}
			],
			"expo-sharing",
			[
				"expo-image-picker",
				{
					"photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can attach them to a conversation or a post.",
					"cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can take a photo for a conversation or a post.",
					"microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone so you can send voice notes in support conversations."
				}
			],
			"./plugins/with-system-bar-insets",
			"expo-video",
			"expo-image",
			[
				"expo-audio",
				{
					"microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone so you can send voice notes in support conversations.",
					"recordAudioAndroid": true,
					"enableBackgroundPlayback": false
				}
			],
			"./plugins/with-store-excluded-from-backup",
			"expo-secure-store",
			"expo-sqlite",
			"expo-apple-authentication",
			[
				"expo-notifications",
				{
					"icon": "./assets/images/notification-icon.png",
					"color": "#6253A3",
					"defaultChannel": "default"
				}
			],
			[
				"expo-build-properties",
				{
					"android": {
						"enableMinifyInReleaseBuilds": true,
						"enableShrinkResourcesInReleaseBuilds": true
					}
				}
			],
			"./plugins/with-r8-optimize"
		],
		"extra": {
			"eas": {
				"projectId": "faad9a83-d245-4c2f-bac3-bca8d61cf1ca"
			},
			"router": {},
			"expo-navigation-bar": {
				"enforceContrast": false,
				"style": "dark"
			}
		},
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"owner": "webphics"
	}
}