{
	"cli": {
		"version": ">= 24.10.0",
		"appVersionSource": "local"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"ios": {
				"simulator": true
			},
			"env": {
				"EXPO_PUBLIC_API_URL": "https://api.zeestglobal.com",
				"EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "225642353646-a4nk5g8l894p17fan5armmpml25plpso.apps.googleusercontent.com",
				"EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "225642353646-9bb7i7t9tfmj43gvg2195lrqdtu6ifqs.apps.googleusercontent.com"
			}
		},
		"preview": {
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"EXPO_PUBLIC_API_URL": "https://api.zeestglobal.com",
				"EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "225642353646-a4nk5g8l894p17fan5armmpml25plpso.apps.googleusercontent.com",
				"EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "225642353646-9bb7i7t9tfmj43gvg2195lrqdtu6ifqs.apps.googleusercontent.com"
			}
		},
		"emulator": {
			"extends": "production",
			"android": {
				"gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a,x86_64",
				"applicationArchivePath": "android/app/build/outputs/apk/release/app-release.apk"
			}
		},
		"production": {
			"distribution": "internal",
			"credentialsSource": "local",
			"android": {
				"gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a",
				"applicationArchivePath": "android/app/build/outputs/apk/release/app-release.apk"
			},
			"env": {
				"EXPO_PUBLIC_API_URL": "https://api.zeestglobal.com",
				"EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "225642353646-a4nk5g8l894p17fan5armmpml25plpso.apps.googleusercontent.com",
				"EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "225642353646-9bb7i7t9tfmj43gvg2195lrqdtu6ifqs.apps.googleusercontent.com"
			}
		}
	}
}