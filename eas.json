{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.zeestglobal.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "753090717715-vtk6in9mcbhfjsls3v60qlk6f5h5bc83.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.zeestglobal.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "753090717715-vtk6in9mcbhfjsls3v60qlk6f5h5bc83.apps.googleusercontent.com"
      }
    },
    "production": {
      "distribution": "internal",
      "credentialsSource": "local",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-release.apk"
      }
    }
  }
}
