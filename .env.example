# Where the API lives. Required — the app refuses to start without it rather than
# defaulting to an address no device can reach (localhost on a phone is the phone).
#
#   Android emulator   http://10.0.2.2:8080   (10.0.2.2 is the emulator's host loopback)
#   iOS simulator      http://localhost:8080
#   Physical device    http://<your machine's LAN IP>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
