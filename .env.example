# Where the API lives. Required — the app refuses to start without it rather than
# defaulting to an address no device can reach (localhost on a phone is the phone).
#
#   Android emulator   http://10.0.2.2:8080   (10.0.2.2 is the emulator's host loopback)
#   iOS simulator      http://localhost:8080
#   Physical device    http://<your machine's LAN IP>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Where the sign-in link in the email points. The API appends
# `/auth/magic-link?token=…` to this, and the app answers that route either way,
# so moving from the custom scheme to a real domain is a change here plus the
# matching app-link association files — never a code change.
#
# Leave it unset and the app falls back to its own scheme from app.json ("enki"),
# which is what you want for a dev build. A custom scheme will not open from Expo
# Go, and several mail clients decline to linkify a non-HTTPS scheme, so expect to
# test the tap half on a dev build or by opening the URL directly.
#
#   Dev build          enki://              (link: enki:/auth/magic-link?token=…)
#   Production         https://app.example.com
EXPO_PUBLIC_MAGIC_LINK_ORIGIN=enki://

# Development builds only: the seed accounts the sign-in screen offers as chips.
# Entries are `role:email:password`, comma-separated; only the first two colons
# separate fields, so a password may contain a colon but not a comma, and
# surrounding whitespace is stripped from every field, so it cannot start or end
# with a space. One entry per role — a second for a role already listed is
# ignored, and an entry that could not sign anyone in is dropped rather than
# taking the sign-in screen down with it.
#
# Picking a chip fills the sign-in form. It does not set a role: signing in is the
# ordinary password path and the role you land in is whatever the server says that
# account holds, so a `role` here that disagrees with the server is a stale label,
# not a claim.
#
# Never set this for a build you ship. It is read behind `__DEV__`, which Metro
# eliminates from a release bundle along with the credentials inlined here.
#
#   EXPO_PUBLIC_DEV_SEED_ACCOUNTS=customer:customer@example.com:pw,agent:agent@example.com:pw,admin:admin@example.com:pw
EXPO_PUBLIC_DEV_SEED_ACCOUNTS=
