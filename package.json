{
  "name": "chatroute",
  "main": "expo-router/entry",
  "version": "1.0.19",
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.2.0",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "lucide-react-native": "^1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "rn-emoji-keyboard": "1.7.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.1"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eas-cli": "^24.14.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "pnpm exec expo start -c",
    "android": "pnpm exec expo start --android -c",
    "ios": "pnpm exec expo start --ios -c",
    "web": "pnpm exec expo start --web",
    "start:lan": "pnpm exec expo start -c",
    "start:tunnel": "pnpm exec expo start -c --tunnel",
    "lint": "expo lint",
    "test": "jest --watchAll=false",
    "release": "npm version --tag-version-prefix=chatroute-v --message=\"chore(release): %s\"",
    "version": "node scripts/sync-app-version.mjs && git add app.json",
    "build:android": "eas build --platform android --profile preview",
    "eas-build-post-install": "node scripts/eas-local-properties.mjs",
    "build:apk:eas": "eas build --platform android --profile production --local --non-interactive --output dist/chatroute-release.apk",
    "build:aab:eas": "eas build --platform android --profile store --local --non-interactive --output dist/chatroute-release.aab",
    "build:apk:emulator": "eas build --platform android --profile emulator --local --non-interactive --output dist/chatroute-emulator.apk"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|@react-native-google-signin/.*|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "private": true
}
