{
  "name": "chatroute",
  "main": "expo-router/entry",
  "version": "1.0.9",
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-media-library": "~57.0.5",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "rn-emoji-keyboard": "1.7.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "eas-cli": "^24.12.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "pnpm exec expo start -c",
    "android": "pnpm exec expo start --android -c",
    "ios": "pnpm exec expo start --ios -c",
    "web": "pnpm exec expo start --web",
    "start:lan": "pnpm exec expo start -c",
    "start:tunnel": "pnpm exec expo start -c --tunnel",
    "lint": "expo lint",
    "test": "jest --watchAll=false",
    "release": "npm version --tag-version-prefix=chatroute-v --message=\"chore(release): %s\"",
    "version": "node scripts/sync-app-version.mjs && git add app.json",
    "build:android": "eas build --platform android --profile preview",
    "eas-build-post-install": "node scripts/eas-local-properties.mjs",
    "build:apk:eas": "eas build --platform android --profile production --local --non-interactive --output dist/chatroute-release.apk",
    "build:apk:emulator": "eas build --platform android --profile emulator --local --non-interactive --output dist/chatroute-emulator.apk"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|@react-native-google-signin/.*|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "private": true
}
